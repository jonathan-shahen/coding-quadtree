{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Make debug build",
            "command": "mingw32-make.exe",
            "args": [
                "debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}/src/cpp",
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
        },

    ],
    "version": "2.0.0"
}